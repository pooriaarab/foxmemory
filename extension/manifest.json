{
  "manifest_version": 3,
  "name": "foxmemory demo",
  "version": "0.1.0",
  "description": "Local memory for AI agents that the user can read, edit, and delete.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxmemory@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "foxmemory demo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"]
    }
  ]
}
